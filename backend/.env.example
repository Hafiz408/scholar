# ── LLM Provider ─────────────────────────────────────────────────────────────
# Mistral (free tier — recommended)
LLM_API_KEY=your-mistral-api-key
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-small-latest

# Embeddings (Mistral embed — 1024-dim, free tier)
EMBEDDING_API_KEY=your-mistral-api-key
EMBEDDING_BASE_URL=https://api.mistral.ai/v1
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSIONS=1024

# OpenAI (alternative — set LLM_BASE_URL= and EMBEDDING_BASE_URL= empty)
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ── PageIndex ─────────────────────────────────────────────────────────────────
PAGEINDEX_API_KEY=your-pageindex-api-key

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=scholar-v1

# ── Infrastructure ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://scholar:scholar_dev_password@db:5432/scholar
SQLITE_PATH=./data/scholar.db
UPLOAD_DIR=./data/uploads
