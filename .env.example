# .env.example — copy to .env and fill in values
POSTGRES_PASSWORD=changeme
PAGEINDEX_API_KEY=pi-...

# ── LLM provider ─────────────────────────────────────────────────────────────
# LLM_PROVIDER selects the backend. Supported values:
#   openai        — OpenAI API (default)
#   openai-compat — Any OpenAI-compatible endpoint (Ollama, Groq, LM Studio, Together…)
#   anthropic     — Anthropic Claude  (pip install langchain-anthropic)
#   google        — Google Gemini     (pip install langchain-google-genai)
LLM_PROVIDER=openai

# OpenAI (default):
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Anthropic Claude:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-5-sonnet-20241022

# Google Gemini:
# LLM_PROVIDER=google
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-2.0-flash

# Ollama (local, OpenAI-compatible):
# LLM_PROVIDER=openai-compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# ── Embedding provider (any OpenAI-compatible embeddings API) ─────────────────
# OpenAI (default, 1536 dims):
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=      # defaults to OPENAI_API_KEY if unset

# Ollama (local, 768 dims):
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# ── Optional observability ────────────────────────────────────────────────────
LANGSMITH_API_KEY=ls-...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=scholar
